# NPC Server 环境变量配置模板
# 复制为 .env 并填写真实值

# 服务端口（uvicorn 监听，Caddy 反代）
SERVER_PORT=8090

# SQLite 数据库路径（相对于 server.py 所在目录）
DB_PATH=./data/npc.db

# 管理员 Token（用于 /api/admin/* 端点，设置随机强密码）
ADMIN_TOKEN=your_random_admin_token_here

# 允许的前端跨域来源（逗号分隔）
CORS_ORIGINS=https://npc.yourdomain.com,http://127.0.0.1:8765

# 日志目录路径
LOG_DIR=./logs

# 日志目录最大占用（MB），超限返回 507
LOG_DIR_MAX_MB=500

# 每用户每分钟最大日志条数
RATE_LIMIT_LOG_PER_USER_PER_MIN=60
