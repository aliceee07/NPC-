.cursor/agent-output/
.cursor/*.log

# --- IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- 操作系统 ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

